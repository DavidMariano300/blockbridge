{
  "name": "blockbridge-academy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx -y node@22.23.4 scripts/servidor.js",
    "test": "npx -y node@22.23.4 --test test/generadores.test.js test/evaluador.test.js test/banco.test.js test/retencion.test.js",
    "test:emulador": "npm run firebase -- emulators:exec --only auth,firestore \"node --test test/reglas.test.js test/api.test.js\"",
    "seed": "npx -y node@22.23.4 scripts/seed.js",
    "firebase": "npx -y -p node@22.23.4 -p firebase-tools@13.35.1 -- firebase --project demo-blockbridge",
    "emuladores": "npm run firebase -- emulators:start",
    "demo": "npx -y node@22.23.4 scripts/demo.js"
  },
  "devDependencies": {
    "blockly": "13.3.0"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.3.1",
    "firebase-admin": "14.5.0"
  },
  "overrides": {
    "jose": "4.15.9",
    "rimraf": "6.1.4"
  },
  "engines": {
    "node": "22.x"
  }
}
